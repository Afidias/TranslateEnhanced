name: Build

on:
  push:
    branches-ignore:
      - builds
  pull_request:
    branches-ignore:
      - builds

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          path: "src"
          fetch-depth: 2

      - name: Checkout builds
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        uses: actions/checkout@v4
        with:
          ref: "builds"
          path: "builds"

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: 17
          distribution: temurin

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Download Gradle Wrapper
        run: |
          cd $GITHUB_WORKSPACE/src
          curl -L -o gradle/wrapper/gradle-wrapper.jar "https://github.com/gradle/gradle/raw/v7.5.1/gradle/wrapper/gradle-wrapper.jar"

      - name: Build Plugins
        run: |
          cd $GITHUB_WORKSPACE/src
          chmod +x gradlew
          ./gradlew :TranslateEnhanced:make generateUpdaterJson --no-daemon
          mkdir $GITHUB_WORKSPACE/compiled
          cp $GITHUB_WORKSPACE/src/TranslateEnhanced/build/*.zip $GITHUB_WORKSPACE/compiled/
          cp $GITHUB_WORKSPACE/src/build/updater.json $GITHUB_WORKSPACE/compiled/

      - name: Upload plugins as artifacts
        uses: actions/upload-artifact@v4
        with:
          name: plugins
          path: compiled

      - name: Push builds
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: |
          cd $GITHUB_WORKSPACE/builds
          cp $GITHUB_WORKSPACE/compiled/* .
          git config --local user.email "actions@github.com"
          git config --local user.name "GitHub Actions"
          git add .
          git commit -m "Build $GITHUB_SHA" || exit 0
          git push
